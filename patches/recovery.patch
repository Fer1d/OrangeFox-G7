+namespace {
+using android::base::unique_fd;
+using namespace ext4_maintenance;
+
+constexpr char kByName[] = "/dev/block/bootdevice/by-name/";
+constexpr char kFsck[] = "/system/bin/e2fsck";
+constexpr char kResize[] = "/system/bin/resize2fs";
+
+string DevId(dev_t dev) {
+	return to_string(major(dev)) + ":" + to_string(minor(dev));
+}
+
+bool HasPartName(dev_t dev, const string& name) {
+	ifstream input("/sys/dev/block/" + DevId(dev) + "/uevent");
+	string line;
+	while (getline(input, line))
+		if (line == "PARTNAME=" + name) return true;
+	return false;
+}
+
+bool OfflineDevice(dev_t dev) {
+	ifstream mounts("/proc/self/mountinfo");
+	if (!Offline(mounts, DevId(dev))) return false;  // Includes bind mounts and aliases.
+	DIR* holders = opendir(("/sys/dev/block/" + DevId(dev) + "/holders").c_str());
+	if (!holders) return false;
+	bool empty = true;
+	errno = 0;
+	while (const auto* entry = readdir(holders)) {
+		if (strcmp(entry->d_name, ".") && strcmp(entry->d_name, "..")) {
+			empty = false;
+			break;
+		}
+	}
+	empty = empty && !errno;
+	closedir(holders);
+	return empty;
+}
+
+// Read only exact GPT metadata partitions. The limit bounds allocation, not a
+// device capacity policy; larger/unreadable metadata blocks growth only.
+bool ReadMetadataPartition(const string& name, std::vector<uint8_t>* image, string* snapshot) {
+	unique_fd fd(open((string(kByName) + name).c_str(), O_RDONLY | O_CLOEXEC));
+	struct stat st;
+	uint64_t bytes = 0;
+	if (fd < 0 || fstat(fd, &st) || !S_ISBLK(st.st_mode) || !HasPartName(st.st_rdev, name) ||
+	    ioctl(fd, BLKGETSIZE64, &bytes) || !bytes || bytes > 16 * 1024 * 1024) return false;
+	image->resize(bytes);
+	if (pread64(fd, image->data(), image->size(), 0) != static_cast<ssize_t>(image->size())) return false;
+	unsigned char digest[SHA256_DIGEST_LENGTH];
+	SHA256(image->data(), image->size(), digest);
+	*snapshot += name + ":" + DevId(st.st_rdev) + ":" + to_string(bytes) + ":";
+	snapshot->append(reinterpret_cast<const char*>(digest), sizeof(digest));
+	return true;
+}
+
+string RuntimeGrowthBounds(int fd, const string& partition, const string& suffix,
+                           uint64_t physical, uint64_t* ceiling, string* snapshot) {
+	AvbBounds bounds{partition, suffix, "", physical, physical};
+	AvbFooter raw, footer;
+	if (pread64(fd, &raw, sizeof(raw), physical - sizeof(raw)) != sizeof(raw))
+		return "Cannot read AVB footer area";
+	snapshot->assign(reinterpret_cast<const char*>(&raw), sizeof(raw));
+	std::vector<uint8_t> embedded;
+	if (!memcmp(raw.magic, AVB_FOOTER_MAGIC, AVB_FOOTER_MAGIC_LEN)) {
+		if (!avb_footer_validate_and_byteswap(&raw, &footer) || !footer.original_image_size ||
+		    footer.original_image_size > footer.vbmeta_offset ||
+		    !footer.vbmeta_size || footer.vbmeta_size > 16 * 1024 * 1024 ||
+		    !Interval(footer.vbmeta_offset, footer.vbmeta_size, physical - sizeof(raw)))
+			return "Invalid AVB footer intervals";
+		bounds.ceiling = footer.original_image_size;
+		// Trees and FEC must also end before the embedded vbmeta region.
+		bounds.physical = footer.vbmeta_offset;
+		embedded.resize(footer.vbmeta_size);
+		if (pread64(fd, embedded.data(), embedded.size(), footer.vbmeta_offset) != static_cast<ssize_t>(embedded.size()))
+			return "Cannot read footer AVB metadata";
+		unsigned char digest[SHA256_DIGEST_LENGTH];
+		SHA256(embedded.data(), embedded.size(), digest);
+		snapshot->append(reinterpret_cast<const char*>(digest), sizeof(digest));
+		if (!ReadAvbBounds(embedded, &bounds)) return bounds.error;
+	}
+	std::vector<uint8_t> external;
+	if (!ReadMetadataPartition("vbmeta" + suffix, &external, snapshot))
+		return "Cannot read complete selected-slot vbmeta";
+	if (!ReadAvbBounds(external, &bounds)) return bounds.error;
+	// A complete readable descriptor set with no target descriptor and no footer
+	// is the supported plain-ext4 case. Absence of a footer alone proves nothing.
+	if (bounds.disabled_flags_layout)
+		LOGINFO("Ext4 growth: verification disabled metadata; layout checked using flags-normalized private copy (not boot authentication)\n");
+	LOGINFO("Ext4 growth %s physical=%llu writable=%llu source=%s\n", partition.c_str(),
+	        static_cast<unsigned long long>(physical), static_cast<unsigned long long>(bounds.ceiling),
+	        bounds.matched ? "AVB descriptor/footer bounds" : (embedded.empty() ? "complete vbmeta: plain ext4" : "AVB footer"));
+	*ceiling = bounds.ceiling;
+	return "";
+}
+
+string ProbeFilesystem(int fd) {
+	blkid_probe probe = blkid_new_probe();
+	if (!probe) return "";
+	const char* type = nullptr;
+	string result;
+	if (blkid_probe_set_device(probe, fd, 0, 0) == 0 && blkid_do_safeprobe(probe) == 0 &&
+	    blkid_probe_lookup_value(probe, "TYPE", &type, nullptr) == 0 && type)
+		result = type;
+	blkid_free_probe(probe);
+	return result;
+}
+
+bool MountedReadWrite(const string& path, dev_t dev) {
+	struct stat st;
+	struct statfs fs;
+	return !stat(path.c_str(), &st) && st.st_dev == dev && !statfs(path.c_str(), &fs) && !(fs.f_flags & MS_RDONLY);
+}
+
+int RunMaintenanceTool(int fd, dev_t dev, bool grow, const string& blocks) {
+	const string target = "/proc/self/fd/" + to_string(fd);
+	const pid_t child = fork();
+	if (child == 0) {
+		// A mount propagated between preflight and exec must not switch resize2fs
+		// to its online path (or cause e2fsck -f to drop its exclusive open).
+		if (unshare(CLONE_NEWNS) || mount(nullptr, "/", nullptr, MS_REC | MS_PRIVATE, nullptr) ||
+		    !OfflineDevice(dev)) _exit(125);
+		if (grow) execl(kResize, "resize2fs", target.c_str(), blocks.c_str(), nullptr);
+		else execl(kFsck, "e2fsck", "-fp", target.c_str(), nullptr);
+		_exit(127);
+	}
+	int status;
+	return child > 0 && TEMP_FAILURE_RETRY(waitpid(child, &status, 0)) == child ? status : -1;
+}
