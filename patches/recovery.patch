+			if (!state.empty() && state != "stopped") return "camera service is active";
+		}
+		const int capacity = number("/sys/class/power_supply/battery/capacity");
+		const int temp = number("/sys/class/power_supply/battery/temp"); // tenths of a degree Celsius
+		if (text("/sys/class/power_supply/battery/health") != "Good" ||
