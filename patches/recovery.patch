diff --git a/ext4_maintenance.hpp b/ext4_maintenance.hpp
new file mode 100644
index 0000000..cbd4bbf
--- /dev/null
+++ b/ext4_maintenance.hpp
@@ -0,0 +1,237 @@
+#ifndef FOX_EXT4_MAINTENANCE_HPP
+#define FOX_EXT4_MAINTENANCE_HPP
+
+#include <cstdint>
+#include <cstring>
+#include <istream>
+#include <sstream>
+#include <string>
+#include <sys/wait.h>
+#include <algorithm>
+#include <vector>
+#include <libavb/libavb.h>
+
+namespace ext4_maintenance {
+
+// Bounds are safety limits, not a boot trust decision. Even a valid signature
+// here only proves consistency with the embedded key; unsigned metadata is allowed.
+inline bool Interval(uint64_t offset, uint64_t size, uint64_t end) {
+	return offset <= end && size <= end - offset;
+}
+
+inline bool GptName(const std::string& name) {
+	return !name.empty() && name.size() <= 72 &&
+	       name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-") == std::string::npos;
+}
+
+inline bool DescriptorMatches(const std::string& name, uint32_t flags,
+                              const std::string& suffix, const std::string& target) {
+	return GptName(name) && (flags & 1 ? name : name + suffix) == target;
+}
+
+struct AvbBounds {
+	std::string target, suffix, error;
+	uint64_t physical, ceiling;
+	bool matched = false;
+	bool disabled_flags_layout = false;
+	bool Reject(const char* reason) { error = reason; return false; }
+	bool Limit(uint64_t bytes) {
+		if (!bytes || bytes > physical) return Reject("AVB image size outside physical partition");
+		ceiling = std::min(ceiling, bytes);
+		matched = true;
+		return true;
+	}
+};
+
+inline bool BoundDescriptor(const AvbDescriptor* raw, void* opaque) {
+	auto& b = *static_cast<AvbBounds*>(opaque);
+	AvbDescriptor d;
+	if (!avb_descriptor_validate_and_byteswap(raw, &d)) return b.Reject("Malformed AVB descriptor");
+	const auto* bytes = reinterpret_cast<const uint8_t*>(raw);
+	const uint64_t total = sizeof(d) + d.num_bytes_following;
+	if (d.tag == AVB_DESCRIPTOR_TAG_CHAIN_PARTITION)
+		return b.Reject("Unresolved AVB chain: growth requires complete metadata");
+	if (d.tag == AVB_DESCRIPTOR_TAG_HASHTREE) {
+		AvbHashtreeDescriptor h;
+		if (total < sizeof(h) || !avb_hashtree_descriptor_validate_and_byteswap(
+		    reinterpret_cast<const AvbHashtreeDescriptor*>(raw), &h) ||
+		    !Interval(sizeof(h), uint64_t(h.partition_name_len) + h.salt_len + h.root_digest_len, total))
+			return b.Reject("Malformed AVB hashtree descriptor");
+		const std::string name(reinterpret_cast<const char*>(bytes + sizeof(h)), h.partition_name_len);
+		if (!GptName(name) || (h.flags & ~uint32_t(1))) return b.Reject("Unsupported AVB hashtree name or flags");
+		if (!DescriptorMatches(name, h.flags, b.suffix, b.target)) return true;
+		if (!b.Limit(h.image_size)) return false;
+		if (!Interval(h.tree_offset, h.tree_size, b.physical) ||
+		    (h.tree_size && h.tree_offset < h.image_size) ||
+		    !Interval(h.fec_offset, h.fec_size, b.physical) ||
+		    (h.fec_size && (h.fec_offset < h.image_size ||
+		     (h.tree_size && h.fec_offset < h.tree_offset + h.tree_size))))
+			return b.Reject("AVB tree/FEC intervals outside partition or overlapping payload");
+		if (h.tree_size) b.ceiling = std::min(b.ceiling, h.tree_offset);
+		if (h.fec_size) b.ceiling = std::min(b.ceiling, h.fec_offset);
+	} else if (d.tag == AVB_DESCRIPTOR_TAG_HASH) {
+		AvbHashDescriptor h;
+		if (total < sizeof(h) || !avb_hash_descriptor_validate_and_byteswap(
+		    reinterpret_cast<const AvbHashDescriptor*>(raw), &h) ||
+		    !Interval(sizeof(h), uint64_t(h.partition_name_len) + h.salt_len + h.digest_len, total))
+			return b.Reject("Malformed AVB hash descriptor");
+		const std::string name(reinterpret_cast<const char*>(bytes + sizeof(h)), h.partition_name_len);
+		if (!GptName(name) || (h.flags & ~uint32_t(1))) return b.Reject("Unsupported AVB hash name or flags");
+		if (DescriptorMatches(name, h.flags, b.suffix, b.target)) return b.Limit(h.image_size);
+	} else if (d.tag != AVB_DESCRIPTOR_TAG_PROPERTY && d.tag != AVB_DESCRIPTOR_TAG_KERNEL_CMDLINE) {
+		return b.Reject("Unknown AVB descriptor: incomplete growth evidence");
+	}
+	return true;
+}
+
+inline bool ReadAvbBounds(const std::vector<uint8_t>& image, AvbBounds* bounds) {
+	auto result = avb_vbmeta_image_verify(image.data(), image.size(), nullptr, nullptr);
+	// avbctl/fastboot disabling verification commonly changes only flags, leaving
+	// the old signature. Recover layout evidence in a PRIVATE COPY, never boot
+	// authorization: only exact flags=3 -> 0 is allowed, and all remaining signed
+	// bytes must still verify. Snapshots always cover the original device bytes.
+	if (result == AVB_VBMETA_VERIFY_RESULT_HASH_MISMATCH && image.size() >= sizeof(AvbVBMetaImageHeader)) {
+		AvbVBMetaImageHeader original;
+		avb_vbmeta_image_header_to_host_byte_order(reinterpret_cast<const AvbVBMetaImageHeader*>(image.data()), &original);
+		if (original.flags == 3) {
+			auto copy = image;
+			reinterpret_cast<AvbVBMetaImageHeader*>(copy.data())->flags = 0;
+			result = avb_vbmeta_image_verify(copy.data(), copy.size(), nullptr, nullptr);
+			if (result == AVB_VBMETA_VERIFY_RESULT_OK) bounds->disabled_flags_layout = true;
+		}
+	}
+	if (result != AVB_VBMETA_VERIFY_RESULT_OK && result != AVB_VBMETA_VERIFY_RESULT_OK_NOT_SIGNED)
+		return bounds->Reject("Invalid AVB metadata structure or signature");
+	AvbVBMetaImageHeader h;
+	avb_vbmeta_image_header_to_host_byte_order(reinterpret_cast<const AvbVBMetaImageHeader*>(image.data()), &h);
+	// libavb's unsigned fast path does not validate this auxiliary interval.
+	if (!Interval(h.descriptors_offset, h.descriptors_size, h.auxiliary_data_block_size))
+		return bounds->Reject("AVB descriptors outside auxiliary block");
+	if (!avb_descriptor_foreach(image.data(), image.size(), BoundDescriptor, bounds)) {
+		if (bounds->error.empty()) bounds->error = "Malformed AVB descriptor list";
+		return false;
+	}
+	return true;
+}
+
+inline uint32_t Le32(const unsigned char* p) {
+	return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+}
+
+struct Geometry {
+	uint64_t blocks;
+	uint64_t block_bytes;
+	uint32_t first_data_block;
+	uint32_t blocks_per_group;
+	uint32_t inodes_per_group;
+	uint32_t inode_bytes;
+	uint32_t descriptor_bytes;
+	uint32_t reserved_gdt_blocks;
+	bool wide;
+};
+
+inline bool HasExternalJournal(const unsigned char (&sb)[1024]) {
+	if ((Le32(sb + 0x60) & 0x8) || Le32(sb + 0xe4)) return true;
+	for (size_t i = 0xd0; i < 0xe0; ++i)
+		if (sb[i]) return true;
+	return false;
+}
+
+inline Geometry ReadGeometry(const unsigned char (&sb)[1024]) {
+	if (sb[0x38] != 0x53 || sb[0x39] != 0xef) return {};
+	const auto shift = Le32(sb + 0x18);
+	if (shift > 6) return {};
+	const bool wide = (Le32(sb + 0x60) & 0x80) != 0;
+	uint64_t blocks = Le32(sb + 4);
+	if (wide) blocks |= uint64_t(Le32(sb + 0x150)) << 32;
+	return {blocks, uint64_t(1024) << shift, Le32(sb + 0x14), Le32(sb + 0x20),
+	        Le32(sb + 0x28), Le32(sb + 0x58) & 0xffff, wide ? Le32(sb + 0xfe) & 0xffff : 32,
+	        Le32(sb + 0xce) & 0xffff, wide};
+}
+
+inline bool Fits(const Geometry& fs, uint64_t ceiling) {
+	return fs.blocks && fs.block_bytes && fs.blocks <= ceiling / fs.block_bytes;
+}
+
+inline uint64_t FilesystemBytes(const std::string& type, const unsigned char (&sb)[1024], uint64_t device_bytes) {
+	if (type == "ext4" || type == "ext3" || type == "ext2") {
+		const auto fs = ReadGeometry(sb);
+		return Fits(fs, device_bytes) ? fs.blocks * fs.block_bytes : 0;
+	}
+	// Legacy EROFS on Judy: little-endian 32-bit block count and block size log2.
+	if (type == "erofs" && Le32(sb) == 0xe0f5e1e2 && sb[12] >= 9 && sb[12] <= 16 &&
+	    !(Le32(sb + 80) & 0x80)) {  // Do not interpret newer 48-bit geometry as legacy.
+		const uint64_t bytes = uint64_t(Le32(sb + 36)) << sb[12];
+		return bytes <= device_bytes ? bytes : 0;
+	}
+	return 0;
+}
+
+inline const char* Mount_Write_Block(const std::string& type, const unsigned char (&sb)[1024]) {
+	if (type == "erofs") return "EROFS is read-only";
+	if (type != "ext4") return "Fresh probe is not ext4";
+	if (Le32(sb + 0x64) & 0x4000) return "Ext4 has shared blocks";
+	return nullptr;
+}
+
+// Raw offline counters use f_bfree semantics: reserved blocks remain free,
+// not used (f_bavail would exclude them).
+inline bool ReadUsage(const unsigned char (&sb)[1024], uint64_t physical,
+                      uint64_t* size, uint64_t* used, uint64_t* free) {
+	const auto fs = ReadGeometry(sb);
+	if (!Fits(fs, physical)) return false;
+	uint64_t available = Le32(sb + 0xc), reserved = Le32(sb + 8);
+	if (fs.wide) {
+		available |= uint64_t(Le32(sb + 0x158)) << 32;
+		reserved |= uint64_t(Le32(sb + 0x154)) << 32;
+	}
+	if (available > fs.blocks || reserved > fs.blocks) return false;
+	*size = fs.blocks * fs.block_bytes;
+	*free = available * fs.block_bytes;
+	*used = *size - *free;
+	return true;
+}
+
+inline uint64_t GrowthCeiling(const Geometry& fs, uint64_t ceiling) {
+	if (!Fits(fs, ceiling) || fs.first_data_block > 1 || !fs.blocks_per_group || !fs.inodes_per_group ||
+	    fs.inode_bytes < 128 || fs.inode_bytes > fs.block_bytes || fs.descriptor_bytes < 32 ||
+	    fs.descriptor_bytes > fs.block_bytes) return 0;
+	uint64_t blocks = ceiling / fs.block_bytes;
+	if (!fs.wide && blocks > UINT32_MAX) blocks = UINT32_MAX;
+	if (blocks < fs.blocks || blocks <= fs.first_data_block) return 0;
+	const uint64_t span = blocks - fs.first_data_block;
+	const uint64_t partial = span % fs.blocks_per_group;
+	const uint64_t groups = span / fs.blocks_per_group + (partial != 0);
+	const uint64_t per_block = fs.block_bytes / fs.descriptor_bytes;
+	if (groups > UINT32_MAX) return 0;
+	// resize2fs can discard a short final block group. Use a conservative
+	// upper bound for its metadata overhead (including a possible backup SB).
+	const uint64_t overhead = 53 + fs.reserved_gdt_blocks + (groups + per_block - 1) / per_block +
+		(uint64_t(fs.inodes_per_group) * fs.inode_bytes + fs.block_bytes - 1) / fs.block_bytes;
+	if (partial && groups > 1 && partial < overhead) blocks -= partial;
+	return blocks;
+}
+
+inline uint64_t Growth(const Geometry& fs, uint64_t ceiling) {
+	const auto blocks = GrowthCeiling(fs, ceiling);
+	return blocks > fs.blocks ? blocks : 0;
+}
+
+inline bool Offline(std::istream& mountinfo, const std::string& device) {
+	std::string line, id, parent, dev, root, mountpoint;
+	bool seen = false;
+	while (std::getline(mountinfo, line)) {
+		std::istringstream record(line);
+		if (!(record >> id >> parent >> dev >> root >> mountpoint) || dev == device) return false;
+		seen = true;
+	}
+	return seen && mountinfo.eof() && !mountinfo.bad();
+}
+
+inline bool ToolSucceeded(int status, bool fsck) {
+	return status >= 0 && WIFEXITED(status) &&
+	       (WEXITSTATUS(status) == 0 || (fsck && WEXITSTATUS(status) == 1));
+}
+
+}  // namespace ext4_maintenance
+#endif
