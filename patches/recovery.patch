+bool TWPartition::Run_Ext4_Maintenance(bool grow, const string& suffix) {
+	const auto fail = [](const string& reason) {
+		gui_msg(Msg(msg::kError, "ext4_maintenance_blocked=Ext4 maintenance: {1}")(reason));
+		return false;
+	};
+	const auto node = Get_Judy_Slot_Block_Device(suffix);
+	// Keep the inspected device pinned across both execs. The tools acquire their
+	// own exclusive kernel block claims; a persistent exclusive fd would deadlock them.
+	unique_fd fd(open(node.c_str(), O_RDONLY));
+	dev_t dev;
+	MaintenanceTarget info;
+	const auto preflight = [&] {
+		info = {};
+		const auto reason = Inspect_Ext4_Target(fd, suffix, &dev, &info);
+		return reason;
+	};
+	const auto reason = preflight();
+	if (!reason.empty()) return fail(reason);
+	// Refresh this object only, without mounting (in particular, never honor an
+	// always-RW preference just to obtain counters). Keep using the pinned slot fd.
+	const auto refresh = [&] {
+		const auto selected = [&] {
+			struct stat st, pinned;
+			return suffix == PartitionManager.Get_Active_Slot_Suffix() &&
+			       !stat(node.c_str(), &st) && !fstat(fd, &pinned) &&
+			       S_ISBLK(st.st_mode) && S_ISBLK(pinned.st_mode) &&
+			       st.st_rdev == dev && pinned.st_rdev == dev && HasPartName(dev,
+			       (Mount_Point == "/system_root" ? "system" : Mount_Point.substr(1)) + suffix);
+		};
+		if (!selected()) return fail("Maintenance completed, but statistics refresh failed: selected device changed");
+		uint64_t size = 0, used = 0, free = 0;
+		struct stat mounted;
+		if (!stat((Mount_Point + "/.").c_str(), &mounted) && mounted.st_dev == dev) {
+			// Mounted counters are live; the on-disk superblock can be stale.
+			struct statfs fs;
+			if (statfs(Mount_Point.c_str(), &fs) || fs.f_bsize <= 0 ||
+			    fs.f_bfree > fs.f_blocks || uint64_t(fs.f_blocks) > UINT64_MAX / uint64_t(fs.f_bsize))
+				return fail("Maintenance completed, but statistics refresh failed: invalid mounted counters");
+			size = uint64_t(fs.f_blocks) * fs.f_bsize;
+			free = uint64_t(fs.f_bfree) * fs.f_bsize;
+			used = size - free;
+		} else {
+			unsigned char sb[1024] = {};
+			if (!OfflineDevice(dev) || pread64(fd, sb, sizeof(sb), 1024) != sizeof(sb) ||
+			    !ReadUsage(sb, info.device_bytes, &size, &used, &free))
+				return fail("Maintenance completed, but statistics refresh failed: cannot read offline counters");
+		}
+		if (!selected()) return fail("Maintenance completed, but statistics refresh failed: selected device changed");
+		Size = size;
+		Used = used;
+		Free = free;
+		Backup_Size = used;
+		return true;
+	};
+	bool at_limit = info.block_bytes && info.filesystem_bytes / info.block_bytes == info.device_bytes / info.block_bytes;
+	if (!at_limit && info.writable_bytes && info.grow_block == "No growth space within runtime AVB/physical bounds") {
+		unsigned char sb[1024] = {};
+		if (pread64(fd, sb, sizeof(sb), 1024) == sizeof(sb)) {
+			const auto fs = ReadGeometry(sb);
+			const auto ceiling = GrowthCeiling(fs, info.writable_bytes);
+			at_limit = Fits(fs, info.writable_bytes) && ceiling && ceiling <= fs.blocks;
+		}
+	}
+	if (grow && at_limit) {
+		gui_msg("ext4_resize_full=Filesystem already at usable limit; no resize needed.");
+		return refresh();
+	}
+	if (!(grow ? info.grow_block : info.repair_block).empty())
+		return fail(grow ? info.grow_block : info.repair_block);
+	if (!UnMount(true) || Is_Mounted() || !OfflineDevice(dev)) return fail("Device is still mounted or has holders");
+	const auto admitted = info;
+	const auto recheck = preflight();
+	if (!recheck.empty()) return fail(recheck);
+	if (!(grow ? info.grow_block : info.repair_block).empty()) return fail(grow ? info.grow_block : info.repair_block);
+	if (info.device_bytes != admitted.device_bytes || info.writable_bytes != admitted.writable_bytes ||
+	    info.metadata_snapshot != admitted.metadata_snapshot) return fail("Physical bounds or AVB metadata changed");
+	const auto still_selected = [&] {
+		struct stat st;
+		return suffix == PartitionManager.Get_Active_Slot_Suffix() && !stat(node.c_str(), &st) &&
+		       S_ISBLK(st.st_mode) && st.st_rdev == dev && OfflineDevice(dev);
+	};
+	if (!still_selected()) return fail("Device state changed");
+	{
+		const string pinned = "/proc/self/fd/" + to_string(fd.get());
+		unique_fd exclusive(open(pinned.c_str(), O_RDONLY | O_EXCL | O_CLOEXEC));
+		if (exclusive < 0) return fail("Block device busy");
+	}
+	const auto before = info;
+	int status = RunMaintenanceTool(fd, dev, false, "");
+	LOGINFO("Offline e2fsck %s wait status: %d\n", node.c_str(), status);
+	if (!ToolSucceeded(status, true))
+		return fail("e2fsck failed (wait status " + to_string(status) + ")");
+	if (!still_selected()) return fail("Device state changed after repair");
+	const auto after_repair = preflight();
+	if (!after_repair.empty()) return fail(after_repair);
+	if (info.device_bytes != before.device_bytes || info.writable_bytes != before.writable_bytes ||
+	    info.metadata_snapshot != before.metadata_snapshot) return fail("Physical bounds or AVB metadata changed after repair");
+	if (!grow) return refresh();
+	if (!info.grow_block.empty()) return fail(info.grow_block);
+	if (info.block_bytes != before.block_bytes || info.grow_blocks != before.grow_blocks ||
+	    info.filesystem_bytes > before.grow_blocks * before.block_bytes || !still_selected())
+		return fail("Device state or growth bounds changed");
+	status = RunMaintenanceTool(fd, dev, true, to_string(before.grow_blocks));
+	LOGINFO("Offline resize2fs %s wait status: %d\n", node.c_str(), status);
+	if (!ToolSucceeded(status, false)) return fail("resize2fs failed (wait status " + to_string(status) + ")");
+	info = {};
+	const auto after_grow = Inspect_Ext4_Target(fd, suffix, &dev, &info);
+	if (!after_grow.empty()) return fail(after_grow);
+	if (!still_selected() || info.device_bytes != before.device_bytes ||
+	    info.writable_bytes != before.writable_bytes || info.metadata_snapshot != before.metadata_snapshot)
+		return fail("Physical bounds or AVB metadata changed after resize");
+	if (info.block_bytes != before.block_bytes || info.filesystem_bytes != before.grow_blocks * before.block_bytes)
+		return fail("Unexpected size after resize");
+	return refresh();
+}
