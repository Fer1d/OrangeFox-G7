+bool TWPartition::Uses_Ext4_Maintenance() const {
+	return strcmp(FOX_DEVICE, "judyln") == 0 &&
+	       (Mount_Point == "/system_root" || Mount_Point == "/vendor" || Mount_Point == "/OP");
+}
+
+string TWPartition::Inspect_Ext4_Target(int fd, const string& suffix, dev_t* dev, MaintenanceTarget* info) {
+	if (!Uses_Ext4_Maintenance()) return "Maintenance not enabled";
+	if ((suffix != "_a" && suffix != "_b") || suffix != PartitionManager.Get_Active_Slot_Suffix())
+		return "Selected slot unavailable or changed";
+	const string base = Mount_Point == "/system_root" ? "system" : Mount_Point.substr(1);
+	const string partition = base + suffix;
+	struct stat st;
+	if (fd < 0 || fstat(fd, &st) || !S_ISBLK(st.st_mode) || !HasPartName(st.st_rdev, partition))
+		return "Exact slot device unavailable";
+	*dev = st.st_rdev;
+	if (ioctl(fd, BLKGETSIZE64, &info->device_bytes) || info->device_bytes < 2048)
+		return "Cannot read physical size";
+	info->filesystem = ProbeFilesystem(fd);
+	unsigned char sb[1024] = {};
+	const bool have_sb = pread64(fd, sb, sizeof(sb), 1024) == sizeof(sb);
+	if (have_sb) info->filesystem_bytes = FilesystemBytes(info->filesystem, sb, info->device_bytes);
+	if (info->filesystem == "erofs") return "EROFS is read-only";
+	if (info->filesystem.empty()) return "Cannot identify filesystem";
+	if (info->filesystem != "ext4") return "Fresh probe is not ext4";
+	if (!have_sb || !info->filesystem_bytes) return "Cannot read ext4 geometry";
+	if (!SlotSelect || Original_Path != kByName + base || Fstab_File_System != "ext4" ||
+	    Is_Encrypted || Is_Decrypted || Is_Super || !Alternate_Block_Device.empty()) return "Not a raw slot ext4 entry";
+	int ro = 1;
+	if (ioctl(fd, BLKROGET, &ro) || ro)
+		info->rw_block = info->repair_block = "Block device is read-only";
+	const auto fs = ReadGeometry(sb);
+	if (HasExternalJournal(sb)) return "Ext4 has an external journal";
+	info->block_bytes = fs.block_bytes;
+	// Metadata limits growth only: historical descriptors must not prevent RW/repair.
+	info->grow_block = RuntimeGrowthBounds(fd, partition, suffix, info->device_bytes,
+	                                     &info->writable_bytes, &info->metadata_snapshot);
+	if (info->grow_block.empty()) info->grow_blocks = Growth(fs, info->writable_bytes);
+	if (const char* reason = Mount_Write_Block(info->filesystem, sb)) info->rw_block = reason;
+	if (info->repair_block.empty() && access(kFsck, X_OK)) info->repair_block = "e2fsck unavailable";
+	if (!info->repair_block.empty()) info->grow_block = info->repair_block;
+	else if (access(kResize, X_OK)) info->grow_block = "resize2fs unavailable";
+	else if (info->grow_block.empty() && !info->grow_blocks) info->grow_block = "No growth space within runtime AVB/physical bounds";
+	return "";
+}
+
+bool TWPartition::Has_Actual_Ext4() {
+	const string node = Get_Judy_Slot_Block_Device(PartitionManager.Get_Active_Slot_Suffix());
+	unique_fd fd(open(node.c_str(), O_RDONLY | O_CLOEXEC));
+	return fd >= 0 && ProbeFilesystem(fd) == "ext4";
+}
