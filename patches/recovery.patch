new file mode 100644
index 0000000..9bd150f
--- /dev/null
+++ b/image_validation.h
@@ -0,0 +1,143 @@
+/* Image-flash preflight. Metadata only: no image-sized allocations or writes. */
+#ifndef RECOVERY_IMAGE_VALIDATION_H
+#define RECOVERY_IMAGE_VALIDATION_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <limits>
+#include <string>
+
+namespace image_validation {
+inline uint16_t Le16(const unsigned char* p) {
+    return uint16_t(p[0]) | (uint16_t(p[1]) << 8);
+}
+inline uint32_t Le32(const unsigned char* p) {
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) |
+           (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+inline bool ReadAt(int fd, uint64_t file_size, uint64_t offset,
+                   unsigned char* data, size_t size) {
+    if (offset > file_size || size > file_size - offset ||
+        file_size > uint64_t(std::numeric_limits<off_t>::max()))
+        return false;
+    while (size) {
+        ssize_t n = pread(fd, data, size, static_cast<off_t>(offset));
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return false;
+        offset += n;
+        data += n;
+        size -= n;
+    }
+    return true;
+}
+
+// CRC payload sizes are checked, not checksum values. simg2img remains the writer.
+inline bool ValidateFd(int fd, uint64_t target_size, uint64_t* image_size,
+                       bool* sparse) {
+    *image_size = 0;
+    *sparse = false;
+    struct stat st;
+    if (!target_size || fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 0)
+        return false;
+    const uint64_t file_size = static_cast<uint64_t>(st.st_size);
+    unsigned char header[28];
+    if (file_size < 4) {
+        *image_size = file_size;
+        return file_size <= target_size;
+    }
+    if (!ReadAt(fd, file_size, 0, header, 4)) return false;
+    if (Le32(header) != 0xed26ff3a) {
+        *image_size = file_size;
+        return file_size <= target_size;
+    }
+    *sparse = true;
+    if (!ReadAt(fd, file_size, 0, header, sizeof(header))) return false;
+    const uint64_t file_header = Le16(header + 8);
+    const uint64_t chunk_header = Le16(header + 10);
+    const uint64_t block_size = Le32(header + 12);
+    const uint64_t total_blocks = Le32(header + 16);
+    const uint64_t chunks = Le32(header + 20);
+    if (Le16(header + 4) != 1 || file_header < 28 || file_header > file_size ||
+        chunk_header < 12 || !block_size || block_size % 4 ||
+        block_size > uint64_t(std::numeric_limits<int>::max()) || !total_blocks ||
+        !chunks || chunks > (file_size - file_header) / chunk_header)
+        return false;
+    // Both factors originate as uint32_t, so multiplication fits uint64_t.
+    const uint64_t expanded = total_blocks * block_size;
+    if (expanded > target_size || expanded > uint64_t(std::numeric_limits<off_t>::max()))
+        return false;
+    uint64_t offset = file_header, blocks = 0;
+    for (uint64_t i = 0; i < chunks; ++i) {
+        unsigned char chunk[12];
+        if (!ReadAt(fd, file_size, offset, chunk, sizeof(chunk))) return false;
+        const uint16_t type = Le16(chunk);
+        const uint64_t count = Le32(chunk + 4);
+        const uint64_t size = Le32(chunk + 8);
+        if (size < chunk_header || size > file_size - offset ||
+            count > total_blocks - blocks)
+            return false;
+        const uint64_t payload = size - chunk_header;
+        switch (type) {
+        case 0xcac1: // RAW
+            if (payload != count * block_size) return false;
+            break;
+        case 0xcac2: // FILL
+            if (payload != 4) return false;
+            break;
+        case 0xcac3: // DONT_CARE
+            if (payload != 0) return false;
+            break;
+        case 0xcac4: // CRC32 contributes no output blocks
+            if (count != 0 || payload != 4) return false;
+            break;
+        default:
+            return false;
+        }
+        blocks += count;
+        offset += size; // bounded by file_size above
+    }
+    if (blocks != total_blocks || offset != file_size) return false;
+    *image_size = expanded;
+    return true;
+}
+inline bool Validate(const std::string& path, uint64_t target_size,
+                     uint64_t* image_size, bool* sparse) {
+    int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0) return false;
+    bool valid = ValidateFd(fd, target_size, image_size, sparse);
+    close(fd);
+    return valid;
+}
+// Flash-only policy: never accept the resolver's unsuffixed/alternate fallback.
+// stat follows ordinary by-name symlinks, but the selected pathname must match.
+inline bool IsBlockDevice(const std::string& path) {
+    struct stat st;
+    return stat(path.c_str(), &st) == 0 && S_ISBLK(st.st_mode);
+}
+template <typename BlockDeviceCheck>
+inline bool ValidateFlashTarget(bool slot_select, const std::string& primary,
+                                const std::string& suffix, const std::string& actual,
+                                BlockDeviceCheck is_block_device) {
+    if (!slot_select) return true;
+    if (primary.empty() || (suffix != "_a" && suffix != "_b")) return false;
+    const std::string selected = primary + suffix;
+    return actual == selected && is_block_device(selected);
+}
+inline std::string ShellQuote(const std::string& path) {
+    std::string quoted("'");
+    for (size_t i = 0; i < path.size(); ++i) {
+        if (path[i] == '\'') quoted += "'\\''";
+        else quoted += path[i];
+    }
+    return quoted + "'";
+}
+template <typename Executor>
+inline bool ExecuteSparse(const std::string& source, const std::string& target,
+                          Executor execute) {
+    return execute("simg2img " + ShellQuote(source) + " " + ShellQuote(target)) == 0;
+}
+} // namespace image_validation
+#endif
diff --git a/image_validation_test.cpp b/image_validation_test.cpp
new file mode 100644
index 0000000..08c2804
--- /dev/null
+++ b/image_validation_test.cpp
@@ -0,0 +1,109 @@
+// Host-only: c++ -std=c++11 -Wall -Wextra -Werror image_validation_test.cpp -o /tmp/image_validation_test
+#include "image_validation.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <vector>
+#include <stdio.h>
+using namespace image_validation;
+using Bytes = std::vector<unsigned char>;
+static void put(Bytes& b, size_t at, uint32_t v, size_t n = 4) {
+    for (size_t i = 0; i < n; ++i) b.at(at + i) = (v >> (8 * i)) & 255;
+}
+static Bytes fixture(uint16_t type = 0xcac3, uint32_t count = 1, uint32_t payload = 0) {
+    Bytes b(40 + payload, 0);
+    put(b, 0, 0xed26ff3a); put(b, 4, 1, 2); put(b, 8, 28, 2);
+    put(b, 10, 12, 2); put(b, 12, 4096); put(b, 16, count); put(b, 20, 1);
+    put(b, 28, type, 2); put(b, 32, count); put(b, 36, 12 + payload);
+    return b;
+}
+static bool valid(const Bytes& b, uint64_t target = 4096) {
+    char name[] = "/tmp/image-validation-XXXXXX";
+    int fd = mkstemp(name); assert(fd >= 0); unlink(name);
+    if (!b.empty()) assert(write(fd, b.data(), b.size()) == static_cast<ssize_t>(b.size()));
+    uint64_t size; bool sparse;
+    bool result = ValidateFd(fd, target, &size, &sparse);
+    close(fd); return result;
+}
+int main() {
+    assert(!valid(Bytes())); assert(!valid(Bytes(512), 0));
+    assert(valid(Bytes(512), 512)); assert(!valid(Bytes(513), 512));
+    assert(valid(Bytes(1), 1)); assert(valid(fixture()));
+    assert(!valid(fixture(), 4095));
+    assert(valid(fixture(0xcac1, 1, 4096)));
+    assert(valid(fixture(0xcac2, 1, 4)));
+    assert(!valid(fixture(0xcac1, 1, 4)));
+    assert(!valid(fixture(0xcac2, 1, 0)));
+    assert(!valid(fixture(0xcac3, 1, 4)));
+    assert(!valid(fixture(0xcac4, 1, 4)));
+    assert(!valid(fixture(0xffff)));
+    Bytes b = fixture();
+    const size_t fields[] = {4, 8, 10, 12, 16, 20, 32, 36};
+    for (size_t at : fields) { Bytes bad = b; put(bad, at, 0, at < 12 ? 2 : 4); assert(!valid(bad)); }
+    for (size_t n = 4; n < b.size(); ++n) assert(!valid(Bytes(b.begin(), b.begin() + n)));
+    b.push_back(0); assert(!valid(b));
+    b = fixture(); put(b, 20, 0xffffffff); assert(!valid(b));
+    b = fixture(); put(b, 36, 0xffffffff); assert(!valid(b));
+    b = fixture(); put(b, 12, 4095); assert(!valid(b));
+    b = fixture(); put(b, 16, 2); assert(!valid(b));
+    b = fixture(); put(b, 32, 2); assert(!valid(b));
+    b = fixture(); put(b, 12, 0xfffffffc); put(b, 16, 0xffffffff);
+    assert(!valid(b, UINT64_MAX));
+    // A tiny compressed image must be judged by its 16 TiB expanded length.
+    b = fixture(0xcac3, 0xffffffff); assert(!valid(b));
+    assert(valid(b, uint64_t(4096) * 0xffffffff));
+    // Valid CRC metadata after a data chunk; CRC must have zero output blocks.
+    b = fixture(); b.resize(56); put(b, 20, 2); put(b, 40, 0xcac4, 2); put(b, 48, 16);
+    assert(valid(b)); put(b, 44, 1); assert(!valid(b));
+    // Extended headers are legal.
+    b = fixture(); b.insert(b.begin() + 28, 4, 0); put(b, 8, 32, 2);
+    b.insert(b.begin() + 44, 4, 0); put(b, 10, 16, 2); put(b, 40, 16);
+    assert(valid(b));
+    uint64_t size; bool sparse;
+    int fd = open("/tmp", O_RDONLY | O_DIRECTORY); assert(fd >= 0);
+    assert(!ValidateFd(fd, 4096, &size, &sparse)); close(fd);
+    assert(!Validate("/nonexistent/image-validation", 4096, &size, &sparse));
+    int calls = 0;
+    assert(!ExecuteSparse("/tmp/a'b;$(bad)", "/dev/a'b", [&](const std::string& command) {
+        ++calls;
+        assert(command == "simg2img '/tmp/a'\\''b;$(bad)' '/dev/a'\\''b'");
+        return 7;
+    }));
+    assert(ExecuteSparse("source", "target", [&](const std::string&) { ++calls; return 0; }));
+    assert(calls == 2);
+    // Mock dispatch behind the same production guard; no block nodes or writes.
+    int writes = 0, probes = 0, slot_cases = 0;
+    auto slot_case = [&](bool slotted, const std::string& primary,
+                         const std::string& suffix, const std::string& actual,
+                         bool selected_is_block, bool expected) {
+        int before = writes;
+        bool allowed = ValidateFlashTarget(slotted, primary, suffix, actual,
+            [&](const std::string& path) {
+                ++probes;
+                assert(path == primary + suffix);
+                return selected_is_block;
+            });
+        if (allowed) ++writes; // simulated backend dispatch only
+        assert(allowed == expected);
+        assert(writes - before == (expected ? 1 : 0));
+        ++slot_cases;
+    };
+    slot_case(true, "/dev/boot", "_a", "/dev/boot_a", true, true);
+    slot_case(true, "/dev/boot", "_b", "/dev/boot_b", true, true);
+    slot_case(true, "/dev/boot", "_b", "/dev/boot", false, false); // stale alias fallback
+    slot_case(true, "/dev/boot", "_b", "/dev/boot_b", false, false); // absent/nonblock
+    slot_case(true, "/dev/boot", "_b", "/dev/boot_a", true, false); // wrong slot
+    slot_case(true, "/dev/boot", "_b", "/dev/alternate", true, false);
+    slot_case(true, "/dev/boot", "", "/dev/boot", true, false);
+    slot_case(true, "/dev/boot", "a", "/dev/boota", true, false);
+    slot_case(true, "/dev/boot", "_c", "/dev/boot_c", true, false);
+    slot_case(true, "", "_a", "_a", true, false);
+    int before = probes;
+    slot_case(false, "/dev/recovery", "", "/dev/recovery", false, true);
+    assert(probes == before); // genuinely unslotted partitions retain existing policy
+    assert(!IsBlockDevice("/tmp"));
+    assert(!IsBlockDevice("/nonexistent/image-validation-block"));
+    char regular[] = "/tmp/image-target-XXXXXX";
+    fd = mkstemp(regular); assert(fd >= 0); close(fd);
+    assert(!IsBlockDevice(regular)); unlink(regular);
+    printf("image validation host fixtures passed; %d slot-policy cases passed (no block-device writes)\n", slot_cases);
+}
diff --git a/judy_sparse_crc32.cpp b/judy_sparse_crc32.cpp
new file mode 100644
index 0000000..a3a3660
--- /dev/null
+++ b/judy_sparse_crc32.cpp
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <stddef.h>
+#include <stdint.h>
+#include <zlib.h>
+
+// The LG recovery updater expects this C symbol. Android Q's libsparse
+// exports a C++ symbol instead. Keep the bridge in judyln recovery only.
+extern "C" __attribute__((visibility("default")))
+uint32_t sparse_crc32(uint32_t crc, const void* data, size_t size) {
+	return size ? static_cast<uint32_t>(crc32_z(crc, static_cast<const Bytef*>(data), size)) : crc;
+}
diff --git a/judy_torch.hpp b/judy_torch.hpp
new file mode 100644
index 0000000..94726a7
--- /dev/null
+++ b/judy_torch.hpp
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <stdint.h>
+#include <string>
+
+// Recovery only. QPNP brightness_get returns the LED class cache, not light or
+// PMIC feedback. No discovery, fallback, trigger writes or camera/debug controls.
+namespace judy_torch {
+
+enum Node { Torch0, Gate, Torch1, Flash0, Flash1, AuxGate };
+constexpr int TorchCurrent = 100;
+struct Led { const char* name; const char* trigger; int maximum; };
+inline const Led& led(Node n) {
+	static const Led nodes[] = {
+		{"led:torch_0", "torch0_trigger", 100}, {"led:switch_0", "switch0_trigger", 255},
+		{"led:torch_1", "torch1_trigger", 100}, {"led:flash_0", "flash0_trigger", 850},
+		{"led:flash_1", "flash1_trigger", 850}, {"led:switch_2", "none", 255},
+	};
+	return nodes[n];
+}
+inline std::string canonical(Node n) {
+	return std::string("/sys/devices/platform/soc/c440000.qcom,spmi/spmi-0/spmi0-03/"
+		"c440000.qcom,spmi:qcom,pmi8998@3:qcom,leds@d300/leds/") + led(n).name;
+}
+
+// Parse the *selected* trigger, not another name in the list of choices.
+inline std::string selected(const std::string& text) {
+	const size_t a = text.find('['), b = text.find(']');
+	if (a == std::string::npos || b == std::string::npos || b <= a + 1 ||
+	    (a && text[a - 1] != ' ') || (b + 1 < text.size() && text[b + 1] != ' ' && text[b + 1] != '\n') ||
+	    text.find_first_of("[]", b + 1) != std::string::npos || text.find('[', a + 1) != std::string::npos)
+		return {};
+	return text.substr(a + 1, b - a - 1);
+}
+
+enum class Write { NotIssued, Uncertain, Complete };
+struct Result {
+	const char* error;
+	int icon; // -1: leave unchanged; 0/1: requested state matches sysfs cache.
+};
+
+// The adapter holds one mutex across the whole action, including reboot cleanup.
+class Controller {
+	enum { DebounceMs = 250, Attempts = 3 };
+	enum class Match { Expected, Changed, Unreadable };
+	unsigned staged = 0, detached = 0; // bit per rear torch
+	bool gateRequested = false, blocked = false, closing = false;
+	int64_t lastTap = -1;
+
+	static unsigned bit(Node n) { return 1u << n; }
+	template<class IO> bool identity(IO& io, Node n) const {
+		const std::string link = std::string("/sys/class/leds/") + led(n).name;
+		return io.resolve(link) == canonical(n) &&
+		       io.resolve(link + "/device/driver") == "/sys/bus/platform/drivers/qcom,qpnp-flash-led-v2" &&
+		       io.number(n, "max_brightness") == led(n).maximum;
+	}
+	template<class IO> int gate(IO& io, Node n) const {
+		return identity(io, n) && io.trigger(n) == led(n).trigger ? io.number(n, "brightness") : -1;
+	}
+	template<class IO> Match configuration(IO& io) const {
+		// The cold DT caches are not armed channels. Leave both flash peers
+		// untouched, unlike Android's camera low path which sets them to zero.
+		for (Node n : {Torch0, Torch1, Flash0, Flash1, AuxGate}) {
+			if (!identity(io, n)) return Match::Unreadable;
+			const std::string trigger = io.trigger(n);
+			const int current = io.number(n, "brightness");
+			if (trigger.empty() || current < 0) return Match::Unreadable;
+			const bool ourDetached = detached & bit(n);
+			const int expected = n == AuxGate ? 0 :
+				(ourDetached && !(staged & bit(n)) ? 0 : led(n).maximum);
+			if (trigger != (ourDetached ? "none" : led(n).trigger) || current != expected)
+				return Match::Changed;
+		}
+		return Match::Expected;
+	}
+
+	template<class IO> Result release(IO& io) {
+		for (int attempt = 0; attempt < Attempts; ++attempt) {
+			if (!identity(io, Gate)) continue;
+			const std::string gateTrigger = io.trigger(Gate);
+			if (gateTrigger.empty()) continue;
+			if (gateTrigger != led(Gate).trigger) {
+				gateRequested = false;
+				blocked = true;
+				return {"shared gate trigger changed", -1};
+			}
+			const int currentGate = io.number(Gate, "brightness");
+			if (currentGate < 0) continue;
+			if (gateRequested || currentGate > 0) {
+				const Match match = gateRequested && currentGate <= 1 ?
+					configuration(io) : Match::Changed;
+				if (match == Match::Unreadable) continue;
+				if (match == Match::Changed) {
+					// Never reclaim a gate after a visible takeover, even if
+					// the same settings recur. Pending torch zeros can retry.
+					gateRequested = false;
+					blocked = true;
+					if (currentGate > 0) return {"shared gate is in use", -1};
+				} else {
+					// An ambiguous ON may have reached the driver, even with
+					// a zero cache. Request OFF, never pulse the gate open.
+					if (gate(io, Gate) != currentGate || io.write(Gate, 0) != Write::Complete ||
+					    io.number(Gate, "brightness") != 0) continue;
+					gateRequested = false;
+				}
+			}
+			for (Node n : {Torch0, Torch1}) {
+				if (!(staged & bit(n)) || !identity(io, n)) continue;
+				const std::string trigger = io.trigger(n);
+				const int current = io.number(n, "brightness");
+				if (trigger.empty() || current < 0) continue;
+				if (current != 0 || trigger != "none") {
+					// 100 is also the cold DT cache. A write that may have
+					// reached sysfs must be cleaned up even if it reads 100.
+					if (current != TorchCurrent || trigger != ((detached & bit(n)) ? "none" : led(n).trigger)) {
+						blocked = true;
+						continue;
+					}
+					if (gate(io, AuxGate) != 0 || gate(io, Gate) != 0 ||
+					    io.write(n, 0) != Write::Complete || io.number(n, "brightness") != 0 ||
+					    io.trigger(n) != "none") continue;
+				}
+				detached |= bit(n); // led-class detaches the torch trigger on zero
+				staged &= ~bit(n);
+			}
+			if (!staged) return {nullptr, 0};
+		}
+		// Leave pending cleanup eligible on the next tap or reboot.
+		return {"could not confirm torch cleanup", -1};
+	}
+
+public:
+	template<class IO> Result toggle(IO& io, bool simulate, int64_t now) {
+		if (simulate || closing) return {nullptr, -1};
+		if (now >= 0 && lastTap >= 0 && now - lastTap < DebounceMs) return {nullptr, -1};
+		lastTap = now;
+		if (staged) {
+			const Result result = release(io);
+			if (result.error) lastTap = -1;
+			return result;
+		}
+		if (blocked) return {"torch enable blocked until recovery restarts", -1};
+		if (!io.isJudy() || configuration(io) != Match::Expected || gate(io, Gate) != 0)
+			return {"unexpected LED identity, owner or idle state", -1};
+		if (const char* error = io.onGuard()) return {error, -1};
+		for (Node n : {Torch0, Torch1}) {
+			// Both writes are required: a 100 cache alone does not arm the LED.
+			const Write result = io.write(n, TorchCurrent);
+			if (result != Write::NotIssued) staged |= bit(n);
+			if (result != Write::Complete || configuration(io) != Match::Expected || gate(io, Gate) != 0)
+				return enableFailed(io, "could not stage both torches");
+		}
+		if (const char* error = io.onGuard()) return enableFailed(io, error);
+		if (configuration(io) != Match::Expected || gate(io, Gate) != 0)
+			return enableFailed(io, "LED state changed during staging");
+		const Write result = io.write(Gate, 1);
+		gateRequested = result != Write::NotIssued;
+		if (result == Write::Complete && configuration(io) == Match::Expected && gate(io, Gate) == 1)
+			return {nullptr, 1};
+		return enableFailed(io, "could not confirm torch enable");
+	}
+	template<class IO> Result shutdown(IO& io) {
+		closing = true; // no later GUI action can re-enable during reboot
+		return staged ? release(io) : Result{nullptr, -1};
+	}
+
+private:
+	template<class IO> Result enableFailed(IO& io, const char* error) {
+		lastTap = -1;
+		if (!staged) return {error, -1};
+		// A zero current leaves led_on set if the gate never enabled. Do not
+		// risk using leftover armed flags with another ON in this session.
+		blocked = true;
+		const Result result = release(io);
+		return {result.error ? result.error : error, result.icon};
+	}
+};
+
+// Defined once in the recovery executable; libguitwrp uses the same owner.
+Result toggle(bool simulate);
+Result shutdown();
+} // namespace judy_torch
