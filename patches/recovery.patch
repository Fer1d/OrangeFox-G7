--- /dev/null
+++ b/tests/ext4_maintenance_test.cpp
@@ -0,0 +1,189 @@
+// Host test: compile C++14 with external/avb include root and link libavb.
+// Optional argv: private read-only vbmeta fixtures; never embed or publish these.
+#include "../ext4_maintenance.hpp"
+
+#include <cassert>
+#include <fstream>
+#include <iterator>
+#include <iostream>
+
+using namespace ext4_maintenance;
+
+int main(int argc, char** argv) {
+	const uint64_t writable_bytes = 28672, device_bytes = 32768;
+	assert(DescriptorMatches("vendor", 0, "_a", "vendor_a"));
+	assert(!DescriptorMatches("vendor", 0, "_b", "vendor_a"));
+	assert(DescriptorMatches("vendor_a", 1, "_b", "vendor_a"));
+	assert(!DescriptorMatches("vendor", 1, "_a", "vendor_a"));
+	assert(!DescriptorMatches("../vendor", 0, "_a", "vendor_a"));
+	assert(!Interval(UINT64_MAX, 1, UINT64_MAX));
+	assert(!Interval(100, UINT64_MAX, 200));
+	std::vector<uint8_t> unsigned_image(sizeof(AvbVBMetaImageHeader), 0);
+	auto* header = reinterpret_cast<AvbVBMetaImageHeader*>(unsigned_image.data());
+	memcpy(header->magic, AVB_MAGIC, AVB_MAGIC_LEN);
+	header->required_libavb_version_major = avb_htobe32(AVB_VERSION_MAJOR);
+	AvbBounds bounds{"vendor_a", "_a", "", 1048576000, 1048576000};
+	assert(ReadAvbBounds(unsigned_image, &bounds));
+	assert(bounds.ceiling == bounds.physical && !bounds.matched);
+	header->descriptors_size = avb_htobe64(8);
+	assert(!ReadAvbBounds(unsigned_image, &bounds));
+	header->descriptors_size = 0;
+	header->magic[0] = 'X';
+	assert(!ReadAvbBounds(unsigned_image, &bounds));
+
+	// All three physical targets, both selected slots: unsigned layout evidence,
+	// matching descriptor, physical overrun, tree overlap, and unresolved chain.
+	for (const std::string base : {"system", "vendor", "OP"}) {
+		for (const std::string suffix : {"_a", "_b"}) {
+			const size_t descriptor_size = (sizeof(AvbHashtreeDescriptor) + base.size() + 7) & ~size_t(7);
+			const size_t aux_size = (descriptor_size + 63) & ~size_t(63);
+			std::vector<uint8_t> image(sizeof(AvbVBMetaImageHeader) + aux_size, 0);
+			auto* h = reinterpret_cast<AvbVBMetaImageHeader*>(image.data());
+			memcpy(h->magic, AVB_MAGIC, AVB_MAGIC_LEN);
+			h->required_libavb_version_major = avb_htobe32(AVB_VERSION_MAJOR);
+			h->auxiliary_data_block_size = avb_htobe64(aux_size);
+			h->descriptors_size = avb_htobe64(descriptor_size);
+			auto* d = reinterpret_cast<AvbHashtreeDescriptor*>(image.data() + sizeof(*h));
+			d->parent_descriptor.tag = avb_htobe64(AVB_DESCRIPTOR_TAG_HASHTREE);
+			d->parent_descriptor.num_bytes_following = avb_htobe64(descriptor_size - sizeof(AvbDescriptor));
+			d->partition_name_len = avb_htobe32(base.size());
+			memcpy(reinterpret_cast<uint8_t*>(d) + sizeof(*d), base.data(), base.size());
+			d->image_size = avb_htobe64(65536);
+			d->tree_offset = avb_htobe64(65536);
+			d->tree_size = avb_htobe64(4096);
+			AvbBounds b{base + suffix, suffix, "", 131072, 131072};
+			assert(ReadAvbBounds(image, &b) && b.matched && b.ceiling == 65536);
+			b = {base + suffix, suffix, "", 32768, 32768};
+			assert(!ReadAvbBounds(image, &b));
+			b = {base + suffix, suffix, "", 131072, 131072};
+			d->tree_offset = avb_htobe64(32768);
+			assert(!ReadAvbBounds(image, &b));
+			d->parent_descriptor.tag = avb_htobe64(AVB_DESCRIPTOR_TAG_CHAIN_PARTITION);
+			assert(!ReadAvbBounds(image, &b));
+			std::cout << "Synthetic selected target: " << base + suffix << " passed" << std::endl;
+		}
+	}
+
+	unsigned char sb[1024] = {};
+	assert(!Fits(ReadGeometry(sb), writable_bytes));
+	sb[0x38] = 0x53;
+	sb[0x39] = 0xef;
+	sb[0x18] = 2;  // 4096-byte blocks.
+	sb[0x21] = 128;  // 32768 blocks/group.
+	sb[0x29] = 32;  // 8192 inodes/group.
+	sb[0x59] = 1;  // 256-byte inodes.
+	sb[4] = 5;
+	auto fs = ReadGeometry(sb);
+	assert(fs.blocks == 5 && fs.block_bytes == 4096);
+	assert(Growth(fs, writable_bytes) == 7);
+	assert(Growth(fs, writable_bytes - 1) == 6);
+	assert(Growth(fs, 5 * 4096) == 0);
+	assert(Growth(fs, 5 * 4096 - 1) == 0);
+	assert(Growth(fs, (32768 + 5) * 4096ULL) == 32768);
+	assert(Growth(fs, (32768 + 1024) * 4096ULL) == 32768 + 1024);
+	fs.blocks = 32768 + 1;
+	assert(Growth(fs, (32768 + 5) * 4096ULL) == 0);
+	assert(GrowthCeiling(fs, (32768 + 5) * 4096ULL) == 32768);
+	fs.blocks = 5;
+	assert(GrowthCeiling(fs, 5 * 4096ULL) == 5);
+	assert(GrowthCeiling(fs, 5 * 4096ULL - 1) == 0);
+	fs.inode_bytes = 0;
+	assert(GrowthCeiling(fs, 5 * 4096ULL) == 0);
+	uint64_t size = 0, used = 0, free = 0;
+	sb[0xc] = 3;
+	sb[8] = 2;
+	assert(ReadUsage(sb, device_bytes, &size, &used, &free));
+	assert(size == 5 * 4096 && used == 2 * 4096 && free == 3 * 4096);
+	sb[0xc] = 6;
+	assert(!ReadUsage(sb, device_bytes, &size, &used, &free));
+	sb[0xc] = 3;
+	sb[8] = 6;
+	assert(!ReadUsage(sb, device_bytes, &size, &used, &free));
+	sb[8] = 0;
+	sb[0xd0] = 1;
+	assert(HasExternalJournal(sb));
+	// Geometry is independent of write admission and remains visible.
+	assert(FilesystemBytes("ext4", sb, device_bytes) == 5 * 4096);
+	assert(!FilesystemBytes("ext4", sb, 5 * 4096 - 1));
+	assert(!FilesystemBytes("unknown", sb, device_bytes));
+	sb[0xd0] = 0;
+	assert(!HasExternalJournal(sb));
+	sb[0x60] = 0x8;
+	assert(HasExternalJournal(sb));
+	sb[0x60] = 0x80;
+	sb[0x150] = 1;
+	assert(ReadGeometry(sb).blocks == (1ULL << 32) + 5);
+	assert(!Fits(ReadGeometry(sb), writable_bytes));
+	const uint64_t large = ((1ULL << 32) + 5) * 4096;
+	assert(FilesystemBytes("ext4", sb, large) == large);
+	sb[0x158] = 1;  // High free block count, not the reserved counter at 0x154.
+	sb[0x154] = 1;
+	assert(ReadUsage(sb, large, &size, &used, &free));
+	assert(size == large && free == ((1ULL << 32) + 3) * 4096 && used == 2 * 4096);
+	sb[0x158] = 2;
+	assert(!ReadUsage(sb, large, &size, &used, &free));
+	sb[0x158] = 1;
+	sb[0x154] = 2;
+	assert(!ReadUsage(sb, large, &size, &used, &free));
+	sb[0x154] = 1;
+	assert(!ReadUsage(sb, large - 1, &size, &used, &free));
+	unsigned char overflow[1024];
+	memcpy(overflow, sb, sizeof(overflow));
+	memset(overflow + 0x150, 0xff, 4);
+	assert(!ReadUsage(overflow, UINT64_MAX, &size, &used, &free));
+	assert(!Mount_Write_Block("ext4", sb));
+	sb[0x65] = 0x40;  // EXT4_FEATURE_RO_COMPAT_SHARED_BLOCKS.
+	assert(Mount_Write_Block("ext4", sb));
+	assert(FilesystemBytes("ext4", sb, large) == large);
+
+	unsigned char erofs[1024] = {0xe2, 0xe1, 0xf5, 0xe0};
+	erofs[12] = 12;
+	erofs[36] = 5;
+	assert(FilesystemBytes("erofs", erofs, device_bytes) == 5 * 4096);
+	assert(!FilesystemBytes("ext4", erofs, device_bytes));
+	assert(!FilesystemBytes("erofs", erofs, 5 * 4096 - 1));
+	assert(Mount_Write_Block("erofs", erofs));
+	erofs[80] = 0x80;
+	assert(!FilesystemBytes("erofs", erofs, device_bytes));
+	erofs[80] = 0;
+	erofs[12] = 255;
+	assert(!FilesystemBytes("erofs", erofs, device_bytes));
+
+	std::istringstream offline("2 1 0:1 / / rw - rootfs rootfs rw\n");
+	std::istringstream bind("9 2 8:64 /subdir /some/alias ro - ext4 /dev/old-link ro\n");
+	std::istringstream empty;
+	std::istringstream broken("1 2\n");
+	assert(Offline(offline, "8:64"));
+	assert(!Offline(bind, "8:64"));
+	assert(!Offline(empty, "8:64"));
+	assert(!Offline(broken, "8:64"));
+
+	assert(ToolSucceeded(0, true));
+	assert(ToolSucceeded(1 << 8, true));
+	for (int code : {2, 3, 4, 8, 16, 32, 128, 125, 127})
+		assert(!ToolSucceeded(code << 8, true));
+	assert(!ToolSucceeded(SIGKILL, true));
+	assert(!ToolSucceeded(-1, true));
+	assert(ToolSucceeded(0, false));
+	assert(!ToolSucceeded(1 << 8, false));
+	for (int i = 1; i < argc; ++i) {
+		std::ifstream file(argv[i], std::ios::binary);
+		std::vector<uint8_t> image((std::istreambuf_iterator<char>(file)), {});
+		AvbBounds vendor{"vendor_a", "_a", "", 1048576000, 1048576000};
+		assert(ReadAvbBounds(image, &vendor));
+		assert(vendor.matched && vendor.ceiling == 1031950336);
+		std::cout << "Fixture vendor runtime ceiling: " << vendor.ceiling << std::endl;
+		for (const std::string suffix : {"_a", "_b"}) {
+			for (const std::string base : {"system", "vendor", "OP"}) {
+				const uint64_t physical = base == "system" ? 4756340736ULL :
+				                          (base == "vendor" ? 1048576000ULL : 660602880ULL);
+				AvbBounds actual{base + suffix, suffix, "", physical, physical};
+				assert(ReadAvbBounds(image, &actual));
+				std::cout << "Fixture " << base + suffix << " physical=" << physical
+				          << " ceiling=" << actual.ceiling << " matched=" << actual.matched << std::endl;
+			}
+		}
+		image[300] ^= 1;
+		assert(!ReadAvbBounds(image, &vendor));
+	}
+}
diff --git a/tests/judy_torch_test.cpp b/tests/judy_torch_test.cpp
new file mode 100644
index 0000000..c5892ab
--- /dev/null
+++ b/tests/judy_torch_test.cpp
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Standalone host test; no Android headers or device/sysfs I/O.
+#include "../judy_torch.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <initializer_list>
+#include <map>
+#include <vector>
+
+using namespace judy_torch;
+#define CHECK(c) do { if (!(c)) { std::fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #c); std::exit(1); } } while (0)
+using Command = std::pair<Node, int>;
+const Command stage0{Torch0, 100}, stage1{Torch1, 100}, on{Gate, 1}, off{Gate, 0}, clear0{Torch0, 0}, clear1{Torch1, 0};
+
+struct Fake {
+	Controller state;
+	bool judy = true, enabled = false, armed[2] = {};
+	bool gateOnIgnored = false;
+	int reads = 0, guards = 0, brightness[6] = {100, 0, 100, 850, 850, 0};
+	int maximum[6] = {100, 255, 100, 850, 850, 255};
+	std::string triggers[6] = {"torch0_trigger", "switch0_trigger", "torch1_trigger", "flash0_trigger", "flash1_trigger", "none"};
+	std::map<std::string, std::string> paths;
+	std::vector<Command> writes;
+	std::map<Command, int> notIssued, uncertain, failAfterWrite;
+	std::function<void(Command)> afterWrite;
+	int badRead[6] = {}, refuseGuard = 0;
+
+	Fake() {
+		for (Node n : {Torch0, Torch1, Gate, Flash0, Flash1, AuxGate}) {
+			const std::string path = std::string("/sys/class/leds/") + led(n).name;
+			paths[path] = canonical(n);
+			paths[path + "/device/driver"] = "/sys/bus/platform/drivers/qcom,qpnp-flash-led-v2";
+		}
+	}
+	bool isJudy() { ++reads; return judy; }
+	const char* onGuard() { return ++guards == refuseGuard ? "guard refused" : nullptr; }
+	std::string resolve(const std::string& p) { ++reads; return paths.at(p); }
+	std::string trigger(Node n) { ++reads; return triggers[n]; }
+	int number(Node n, const std::string& attr) {
+		++reads;
+		if (attr == "max_brightness") return maximum[n];
+		CHECK(attr == "brightness");
+		if (badRead[n] > 0) { --badRead[n]; return -1; }
+		return brightness[n];
+	}
+	Write write(Node n, int v) {
+		Command cmd{n, v};
+		CHECK(cmd == stage0 || cmd == stage1 || cmd == on || cmd == off || cmd == clear0 || cmd == clear1);
+		CHECK(n == Gate || (brightness[Gate] == 0 && brightness[AuxGate] == 0));
+		writes.push_back(cmd);
+		if (notIssued[cmd] > 0) { --notIssued[cmd]; return Write::NotIssued; }
+		if (uncertain[cmd] > 0) { --uncertain[cmd]; return Write::Uncertain; }
+		brightness[n] = v;
+		if (cmd == stage0 || cmd == stage1) armed[n == Torch1] = true;
+		if (cmd == clear0 || cmd == clear1) triggers[n] = "none"; // does NOT disarm
+		if (cmd == on) {
+			CHECK(armed[0] && armed[1]);
+			enabled = !gateOnIgnored;
+		}
+		if (cmd == off && enabled) enabled = armed[0] = armed[1] = false;
+		if (afterWrite) afterWrite(cmd);
+		if (failAfterWrite[cmd] > 0) { --failAfterWrite[cmd]; return Write::Uncertain; }
+		return Write::Complete;
+	}
+	Result tap(int64_t t = 1000, bool simulate = false) { return state.toggle(*this, simulate, t); }
+	Result reboot() { return state.shutdown(*this); }
+	void expect(std::initializer_list<Command> commands) {
+		CHECK(writes == std::vector<Command>(commands));
+		writes.clear();
+	}
+	void expectBlocked(int64_t t = 5000) {
+		const Result r = tap(t);
+		CHECK(r.error && r.icon == -1);
+		expect({});
+	}
+};
+
+static void normal() {
+	Fake idle;
+	CHECK(idle.reads == 0 && idle.tap(0, true).icon == -1);
+	CHECK(!idle.reboot().error && idle.reads == 0 && idle.guards == 0);
+	CHECK(idle.tap().icon == -1 && idle.reads == 0);
+	idle.expect({});
+
+	Fake f;
+	for (int t : {1000, 2000}) {
+		CHECK(!f.armed[0] && !f.armed[1]);
+		const Result r = f.tap(t);
+		CHECK(!r.error && r.icon == 1 && f.enabled);
+		f.expect({stage0, stage1, on});
+		int before = f.reads;
+		CHECK(f.tap(t + 1).icon == -1 && f.tap(t + 400, true).icon == -1 && f.reads == before);
+		CHECK(f.tap(t + 500).icon == 0 && !f.enabled && !f.armed[0] && !f.armed[1]);
+		f.expect({off, clear0, clear1});
+		CHECK(f.triggers[Torch0] == "none" && f.triggers[Torch1] == "none" && f.triggers[Gate] == "switch0_trigger");
+	}
+	int before = f.reads;
+	CHECK(!f.reboot().error && f.reads == before && f.guards == 4);
+	f.expect({});
+
+	Fake reboot;
+	CHECK(reboot.tap().icon == 1 && reboot.reboot().icon == 0);
+	CHECK(reboot.tap(5000).icon == -1 && !reboot.reboot().error);
+	reboot.expect({stage0, stage1, on, off, clear0, clear1});
+}
+
+static void preflight() {
+	Fake board;
+	board.judy = false;
+	CHECK(board.tap().error && board.reads == 1);
+	board.expect({});
+	for (Node n : {Torch0, Torch1, Gate, Flash0, Flash1, AuxGate}) {
+		for (int problem = 0; problem < 7; ++problem) {
+			Fake f;
+			const std::string p = std::string("/sys/class/leds/") + led(n).name;
+			switch (problem) {
+			case 0: f.paths[p] = ""; break;
+			case 1: f.paths[p] = canonical(n) + "_1"; break;
+			case 2: f.paths[p] = "/other/" + canonical(n); break;
+			case 3: f.paths[p + "/device/driver"] += "-other"; break;
+			case 4: f.maximum[n]--; break;
+			case 5: f.triggers[n] = n == AuxGate ? "switch2_trigger" : "none"; break;
+			case 6: f.brightness[n] = n == Flash0 || n == Flash1 ? 0 : 1; break;
+			}
+			CHECK(f.tap().error);
+			f.expect({});
+			int before = f.reads;
+			CHECK(!f.reboot().error && f.reads == before);
+		}
+	}
+	Fake guard;
+	guard.refuseGuard = 1;
+	CHECK(guard.tap().error);
+	guard.expect({});
+	CHECK(guard.tap(2000).icon == 1); // declined before any staging
+	guard.refuseGuard = guard.guards + 1;
+	CHECK(guard.tap(3000).icon == 0 && guard.guards == 3); // OFF never runs the ON guard
+	guard.expect({stage0, stage1, on, off, clear0, clear1});
+
+	CHECK(selected("none heartbeat [torch0_trigger] timer \n") == "torch0_trigger");
+	CHECK(selected("[none] timer torch0_trigger \n") == "none");
+	for (const char* bad : {"", "none torch0_trigger", "[none] [torch0_trigger]", "x[torch0_trigger]", "[torch0_trigger]x"})
+		CHECK(selected(bad).empty());
+}
+
+static void stagingFailures() {
+	Fake unopened;
+	unopened.notIssued[stage0] = 1;
+	CHECK(unopened.tap().error);
+	unopened.expect({stage0});
+	CHECK(unopened.tap(1001).icon == 1); // nothing may have been staged
+	unopened.expect({stage0, stage1, on});
+
+	Fake secondUnopened;
+	secondUnopened.notIssued[stage1] = 1;
+	CHECK(secondUnopened.tap().error);
+	secondUnopened.expect({stage0, stage1, clear0});
+	CHECK(secondUnopened.armed[0] && !secondUnopened.armed[1]);
+	CHECK(secondUnopened.brightness[Torch1] == 100 && secondUnopened.triggers[Torch1] == "torch1_trigger");
+	secondUnopened.expectBlocked();
+
+	for (Command failed : {stage0, stage1}) {
+		for (int failure = 0; failure < 3; ++failure) {
+			Fake f;
+			if (failure == 0) f.uncertain[failed] = 1;
+			if (failure == 1) f.failAfterWrite[failed] = 1;
+			if (failure == 2) f.afterWrite = [&](Command cmd) { if (cmd == failed) f.badRead[cmd.first] = 1; };
+			CHECK(f.tap().error && !f.enabled);
+			if (failed == stage0) f.expect({stage0, clear0});
+			else f.expect({stage0, stage1, clear0, clear1});
+			f.expectBlocked();
+		}
+	}
+	Fake wrongStage;
+	wrongStage.afterWrite = [&](Command c) { if (c == stage1) wrongStage.brightness[Torch1] = 47; };
+	CHECK(wrongStage.tap().error && !wrongStage.enabled);
+	wrongStage.expect({stage0, stage1, clear0}); // don't clear a foreign current
+	wrongStage.brightness[Torch1] = 100;
+	CHECK(wrongStage.tap(1001).icon == 0);
+	wrongStage.expect({clear1});
+	wrongStage.expectBlocked();
+
+	Fake lateGuard;
+	lateGuard.refuseGuard = 2;
+	CHECK(lateGuard.tap().error);
+	lateGuard.expect({stage0, stage1, clear0, clear1});
+	lateGuard.expectBlocked();
+}
+
+static void gateFailures() {
+	for (int failure = 0; failure < 5; ++failure) {
+		Fake f;
+		if (failure == 0) f.notIssued[on] = 1;
+		if (failure == 1) f.uncertain[on] = 1;
+		if (failure == 2) f.failAfterWrite[on] = 1;
+		if (failure == 3) f.afterWrite = [&](Command c) { if (c == on) f.badRead[Gate] = 1; };
+		if (failure == 4) {
+			f.gateOnIgnored = true;
+			f.afterWrite = [&](Command c) { if (c == on) f.brightness[Gate] = 0; };
+		}
+		CHECK(f.tap().error && !f.enabled);
+		if (failure == 0) f.expect({stage0, stage1, on, clear0, clear1});
+		else f.expect({stage0, stage1, on, off, clear0, clear1});
+		CHECK(f.armed[0] == (failure == 0 || failure == 1 || failure == 4));
+		f.expectBlocked();
+	}
+	// The LED class provides no way to distinguish this hardware failure
+	// from successful sysfs writes; the icon reflects only the request/cache.
+	Fake cacheOnly;
+	cacheOnly.gateOnIgnored = true;
+	CHECK(cacheOnly.tap().icon == 1 && !cacheOnly.enabled);
+	CHECK(cacheOnly.tap(2000).icon == 0 && cacheOnly.armed[0] && cacheOnly.armed[1]);
+	cacheOnly.expect({stage0, stage1, on, off, clear0, clear1});
+
+	Fake failedOff;
+	CHECK(failedOff.tap().icon == 1);
+	failedOff.notIssued[off] = 3;
+	Result r = failedOff.tap(2000);
+	CHECK(r.error && r.icon == -1 && failedOff.brightness[Gate] == 1);
+	failedOff.expect({stage0, stage1, on, off, off, off});
+	CHECK(failedOff.tap(2001).icon == 0); // failed OFF bypasses debounce
+	failedOff.expect({off, clear0, clear1});
+	CHECK(failedOff.tap(3000).icon == 1);
+	failedOff.expect({stage0, stage1, on});
+
+	Fake badOffRead;
+	CHECK(badOffRead.tap().icon == 1);
+	int once = 1;
+	badOffRead.afterWrite = [&](Command c) { if (c == off && once-- > 0) badOffRead.badRead[Gate] = 1; };
+	CHECK(badOffRead.reboot().icon == 0);
+	badOffRead.expect({stage0, stage1, on, off, off, clear0, clear1});
+
+	Fake failedClear;
+	CHECK(failedClear.tap().icon == 1);
+	failedClear.notIssued[clear0] = 3;
+	r = failedClear.tap(2000);
+	CHECK(r.error && r.icon == -1 && failedClear.brightness[Gate] == 0);
+	failedClear.expect({stage0, stage1, on, off, clear0, clear1, clear0, clear0});
+	CHECK(failedClear.reboot().icon == 0);
+	failedClear.expect({clear0});
+}
+
+static void external() {
+	Fake race;
+	race.afterWrite = [&](Command c) { if (c == stage0) race.brightness[Gate] = 1; };
+	CHECK(race.tap().error);
+	race.expect({stage0}); // did not touch the newly occupied gate or stage the second torch
+	CHECK(race.tap(1001).error);
+	race.expect({});
+	race.brightness[Gate] = 0;
+	CHECK(race.tap(1002).icon == 0);
+	race.expect({clear0});
+	race.expectBlocked();
+
+	Fake trigger;
+	CHECK(trigger.tap().icon == 1);
+	trigger.triggers[Gate] = "none";
+	CHECK(trigger.tap(2000).error);
+	trigger.triggers[Gate] = led(Gate).trigger;
+	CHECK(trigger.tap(2001).error); // restored trigger is not new ownership
+	trigger.expect({stage0, stage1, on});
+
+	for (Node n : {Gate, Torch0, Torch1, Flash0, Flash1, AuxGate}) {
+		Fake changed;
+		CHECK(changed.tap().icon == 1);
+		const int original = changed.brightness[n];
+		changed.brightness[n] = 24; // configuration no longer ours
+		CHECK(changed.tap(2000).error);
+		changed.brightness[n] = original;
+		CHECK(changed.tap(2001).error); // don't reclaim the running gate
+		changed.expect({stage0, stage1, on});
+		changed.brightness[Gate] = 0;
+		CHECK(changed.tap(2002).icon == 0);
+		changed.expect({clear0, clear1});
+		changed.expectBlocked();
+	}
+}
+
+int main() {
+	normal(); preflight(); stagingFailures(); gateFailures(); external();
+	std::puts("Judy dual torch host tests passed (fake LED class only)");
+}
diff --git a/orangefox.mk b/orangefox.mk
index ec6cf5a..2b30956 100644
--- a/orangefox.mk
+++ b/orangefox.mk
@@ -120,6 +120,10 @@ else
     LOCAL_CFLAGS += -DOF_MAINTAINER='"Testing build (unofficial)"'
 endif
 
