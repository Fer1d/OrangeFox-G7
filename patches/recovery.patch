+string TWPartition::Get_Judy_Slot_Block_Device(const string& suffix) const {
+	static const string by_name = "/dev/block/bootdevice/by-name/";
+	if ((suffix != "_a" && suffix != "_b") || Original_Path.compare(0, by_name.size(), by_name) != 0)
+		return "";
+	const string name = Original_Path.substr(by_name.size()) + suffix;
+	if (name.size() <= suffix.size() || name.find('/') != string::npos)
+		return "";
+	const string node = by_name + name;
+	struct stat st;
+	if (stat(node.c_str(), &st) != 0 || !S_ISBLK(st.st_mode))
+		return "";
+
+	// A suffixed link to the wrong block device is not a valid slot target.
+	const string uevent = "/sys/dev/block/" + to_string(major(st.st_rdev)) + ":" +
+		to_string(minor(st.st_rdev)) + "/uevent";
+	FILE* fp = fopen(uevent.c_str(), "re");
+	if (!fp)
+		return "";
+	const string expected = "PARTNAME=" + name + "\n";
+	char line[256];
+	bool matches = false;
+	while (fgets(line, sizeof(line), fp)) {
+		if (expected == line) {
+			matches = true;
+			break;
+		}
+	}
+	fclose(fp);
+	return matches ? node : "";
+}
